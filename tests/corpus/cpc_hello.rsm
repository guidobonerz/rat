; raw dialect, Amstrad CPC
.platform cpc
.amsdos name="HELLO.BIN", exec=start
.org $4000
start:
    ld hl, msg
@loop:
    ld a, (hl)
    or a
    ret z
    call $bb5a          ; TXT OUTPUT
    inc hl
    jr @loop
msg: .text "Hello CPC!", 13, 10
     .byte 0
    ld (ix+5), a
    ld (iy-2), $12
    res 3, (ix+1), b
    sll c
    out (c), 0
    im 1
    rst $38
    ex af, af'
    ld ixh, 5
    djnz +
+   nop
