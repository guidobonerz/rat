.platform amiga
start:
    move.l  #msg, a0
    lea     sub(pc), a1
    move.w  #$4000, $dff09a
    moveq   #0, d0
.loop:
    addq.l  #1, d0
    cmp.l   #100, d0
    bne.s   .loop
    movem.l d0-d7/a0-a6, -(sp)
    movem.l (sp)+, d0-d7/a0-a6
    jsr     sub
    rts
sub:
    move.l  4(a0,d1.w), d2
    lsl.w   #2, d3
    dbra    d0, sub
    rts
.amiga.section data, data
msg: dc.b "hello", 0
ptr: dc.l start, msg
