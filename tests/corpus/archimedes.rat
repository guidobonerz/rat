; Acorn Archimedes: RISC OS application code at $8000
.platform archimedes
.org $8000

OS_WriteC = 0
OS_Exit   = $11

start:  adr r1, text
loop:   ldrb r0, [r1], #1
        cmp r0, #0
        swine OS_WriteC
        bne loop
        stmfd r13!, {r0-r3, r14}
        mov r2, #$ff000000
        mvn r3, #0
        add r2, r2, r3, lsl #2
        ldr r4, value
        mul r5, r4, r2
        teqp pc, #0
        bl sub
        ldmfd r13!, {r0-r3, r14}
        swi OS_Exit
sub:    movs pc, r14
value:  .long $12345678
text:   .asciiz "Hello from rat"
        .align 4
