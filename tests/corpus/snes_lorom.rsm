.platform snes
.snes.header title="RAW TEST", map=lorom
.org $008000
reset:
    sei
    clc
    xce
    rep #$30
    .a16
    .i16
    lda #$1234
    ldx #$0000
    sta $7e0000,x
    mvn $7e, $00
    jml reset
spc_code:
.snes.spc $0200 {
    mov a, #$10
    mov $f2, a
    mov a, !$1234+x
    set1 $10.3
    bbs $10.3, spin
    mov $10, $20
    mov $10, #$5
spin: bra spin
}
spc_end:
.org $00ffe0
    .fill 28, 0
    .word reset, 0
